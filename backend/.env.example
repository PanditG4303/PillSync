FRONTEND_URL=http://localhost:5173
DATABASE_URL=sqlite:///./pillsync.db
APP_TIMEZONE=Asia/Kolkata
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=72
ENVIRONMENT=development

# OpenRouter API key - shared by both AI models
OPENROUTER_API_KEY=
# Gemma handles prescription OCR and image understanding
AI_MODEL_OCR=google/gemma-4-26b-a4b-it:free
# Backup models tried automatically when the primary model is rate limited
# or failing (comma-separated). Paid models work even when the free tier
# daily quota is exhausted (needs credits on the OpenRouter account).
AI_MODEL_OCR_FALLBACKS=google/gemma-3-27b-it,openai/gpt-4o-mini
# Nemotron handles every other AI feature (chat, health insights, nutrition,
# medicine inference, reports, etc.)
AI_MODEL_ASSISTANT=nvidia/nemotron-3.5-lightning:free
AI_MODEL_ASSISTANT_FALLBACKS=openai/gpt-4o-mini,anthropic/claude-3-5-haiku-20241022

# Google Sign-In (optional - email/password login keeps working without it)
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8000/auth/google/callback
# Users who sign in with Google get a profile picture automatically.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email OTP login (optional - without SMTP the code is returned in the API
# response for development only). For Gmail: SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=587, SMTP_USER=<your-email>, SMTP_PASSWORD=<app password from
# https://myaccount.google.com/apppasswords>. SMTP_FROM defaults to SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
EMAIL_FROM_NAME=PillSync

# Firebase Cloud Messaging (optional - reminders work without it)
# Option 1: Path to service account JSON file
FCM_CREDENTIALS_PATH=
# Option 2: Full JSON content as string
FCM_CREDENTIALS_JSON=

# Optional SMS reminders (disabled when unset - browser/Firebase still work)
# Supported providers: msg91, fast2sms
SMS_PROVIDER=
# MSG91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
# Fast2SMS
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
