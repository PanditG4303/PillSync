FRONTEND_URL=http://localhost:5173
DATABASE_URL=sqlite:///./pillsync.db
APP_TIMEZONE=Asia/Kolkata
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=72

# OpenRouter AI prescription extraction (required for the scanner)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Firebase Cloud Messaging (optional - reminders work without it)
# Option 1: Path to service account JSON file
FCM_CREDENTIALS_PATH=
# Option 2: Full JSON content as string
FCM_CREDENTIALS_JSON=
